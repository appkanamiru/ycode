# Values for a local run (docker-compose.local.yml). Not for production.
POSTGRES_PASSWORD=local-development-only
BETTER_AUTH_SECRET=local-development-only-change-me-in-production
BETTER_AUTH_URL=https://app.localtest.me
PLATFORM_SITES_DOMAIN=localtest.me
PLATFORM_DOMAIN_IPV4=127.0.0.1
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Local platform <noreply@localtest.me>"
CLOUDFLARE_API_TOKEN=not-used-locally
UMAMI_PUBLIC_URL=https://stats.localtest.me
UMAMI_DB_PASSWORD=local-development-only
UMAMI_APP_SECRET=local-development-only
UMAMI_ADMIN_PASSWORD=local-development-only
# Your sign-in email here, to open the statistics from the editor's menu
PLATFORM_ADMIN_EMAILS=
