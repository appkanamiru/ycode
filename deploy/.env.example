# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Database password (Postgres runs in the stack)
POSTGRES_PASSWORD=

# Long random string, e.g. `openssl rand -base64 48`. Signs sessions, upload
# URLs and realtime tokens; changing it signs everyone out.
BETTER_AUTH_SECRET=

# The editor's address, and the domain whose subdomains are the free sites
BETTER_AUTH_URL=https://app.appkanamiru.cz
PLATFORM_SITES_DOMAIN=appkanamiru.cz

# This server's public IPv4: the A record customers set for apex domains
PLATFORM_DOMAIN_IPV4=

# Outgoing mail for sign-in codes and invitations
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Appkanamiru <prihlaseni@appkanamiru.cz>"

# The builder named in published sites (generator meta tag, source comment).
# Defaults to Appkanamiru / appkanamiru.cz.
# SITE_GENERATOR_NAME=Appkanamiru
# SITE_GENERATOR_URL=appkanamiru.cz

# Cloudflare API token (Zone > DNS > Edit on the platform domain), used by
# Caddy for the wildcard certificate. Keep the platform's DNS records
# "DNS only" (grey cloud): customers' domains CNAME to their site's
# subdomain, which Cloudflare's proxy would refuse for foreign domains.
CLOUDFLARE_API_TOKEN=
